---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticlePage from '../../components/ArticlePage.jsx';

// Titre/description génériques : le contenu réel (géré depuis le CMS après
// le build, voir ArticlePage.jsx) met à jour document.title côté client une
// fois l'article chargé. Voir la note dans ArticlePage.jsx sur le choix
// d'une page unique + ?slug= plutôt qu'un segment d'URL dynamique.
const title = "Actualité – Festival Hwendo-Culture 2026";
const description = "Actualité du Festival Hwendo-Culture.";
---

<BaseLayout
  title={title}
  description={description}
  ogTitle={title}
  ogDescription={description}
  ogType="article"
  robots="noindex, follow"
>
  <main class="min-h-screen bg-white">
    <ArticlePage client:load />
  </main>
</BaseLayout>
