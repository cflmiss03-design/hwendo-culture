---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsList from '../../components/NewsList.jsx';

const title = "Actualités – Festival Hwendo-Culture 2026";
const description = "Toute l'actualité du Festival Hwendo-Culture : annonces, coulisses et temps forts de la Nuit de l'Élégance Africaine, du Concours Miss Endo-Culture et du Match de Gala.";
const keywords = "actualités Festival Hwendo-Culture, actu Hwendo-Culture, annonces festival, culture béninoise";
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  ogTitle={title}
  ogDescription={description}
  ogType="website"
>
  <main class="min-h-screen bg-slate-50">
    <section class="relative overflow-hidden bg-gradient-to-br from-primary-800 via-primary-700 to-secondary-700 px-4 py-16 text-center sm:py-20">
      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-secondary-300">Festival Hwendo-Culture</p>
      <h1 class="mt-3 font-heading text-4xl font-black text-white sm:text-5xl">Actualités</h1>
      <p class="mx-auto mt-4 max-w-2xl text-base text-white/80 sm:text-lg">
        Annonces, coulisses et temps forts du festival, au fil de l'édition 2026.
      </p>
    </section>

    <section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <NewsList client:load />
      </div>
    </section>
  </main>
</BaseLayout>
