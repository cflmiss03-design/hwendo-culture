---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TicketDownload from "../../../components/TicketDownload.jsx";
import { CATEGORIES } from "../../../config/categories.js";

export async function getStaticPaths() {
  return Object.keys(CATEGORIES).map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
const cat = CATEGORIES[category];
---

<BaseLayout
  title={`Télécharger mes tickets – ${cat.label} – Festival Hwendo Culture`}
  description={`Téléchargez vos tickets ${cat.label}, Festival Hwendo Culture.`}
  robots="noindex,nofollow"
>
  <main class="min-h-screen bg-slate-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <div class="mb-8 space-y-2 text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-primary-600">Tickets — {cat.label}</p>
        <h1 class="text-3xl md:text-4xl font-heading font-bold text-slate-900">
          Mes tickets
        </h1>
      </div>

      <div class="bg-white rounded-2xl shadow-lg border border-slate-200 p-6 sm:p-10">
        <TicketDownload client:load />
      </div>
    </div>
  </main>
</BaseLayout>
