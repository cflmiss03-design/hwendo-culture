---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CATEGORIES } from "../config/categories.js";

const title = "Festival Hwendo-Culture 2026 – Nos racines sont notre avenir";
const description = "Festival Hwendo-Culture : valorisation, sauvegarde et transmission des cultures endogènes béninoises, à travers la Nuit de l'Élégance Africaine (TOP Modèle Afrique & Jeune Créateur), le Concours Miss Endo-Culture et le Match de Gala. Votez en ligne, votes sécurisés via FedaPay.";
const keywords = "Festival Hwendo-Culture, TOP Modèle Afrique, Jeune Créateur, Miss Endo-Culture, Nuit de l'Élégance Africaine, Match de Gala, culture béninoise, cultures endogènes, Dahomey";

const CATEGORY_VISUALS = {
  "top-modele-afrique": { emoji: "🕴️", gradient: "from-primary-700 to-primary-500" },
  "jeune-createur": { emoji: "✂️", gradient: "from-secondary-600 to-secondary-400" },
  "miss-endo-culture": { emoji: "👑", gradient: "from-primary-800 to-primary-600" },
};

const STATS = [
  { value: "2026", label: "Édition actuelle" },
  { value: "3", label: "Événements majeurs" },
  { value: "19+", label: "Talents en compétition" },
];

const RENDEZVOUS = [
  {
    icon: "⚽",
    title: "Match de Gala",
    text: "Un moment de sport, de partage et de convivialité qui rassemble les générations autour d'une même passion et crée des liens au-delà des différences.",
  },
  {
    icon: "✨",
    title: "La Nuit de l'Élégance Africaine",
    text: "Une grande soirée consacrée à la mode africaine, au mannequinat culturel et au génie créatif.",
    sub: [
      { label: "TOP Modèle-Mannequin Afrique", text: "compétition destinée aux mannequins féminins et masculins portant avec charisme, grâce et prestance des créations réalisées à partir de tissus traditionnels africains." },
      { label: "Concours des Stylistes & Créateurs", text: "récompense les créateurs et créatrices mettant à l'honneur les tissages traditionnels Kanvo, le Batik et les pagnes d'Afrique." },
    ],
  },
  {
    icon: "👑",
    title: "Concours Miss Endo-Culture",
    text: "Bien plus qu'un concours de beauté, une aventure autour de la connaissance, de l'identité et de la transmission du patrimoine culturel béninois.",
  },
];

// Aperçu (3 photos) de la galerie complète — voir /galerie pour l'ensemble
// des clichés du festival avec légendes, animations et visionneuse.
const GALLERY_PREVIEW = [
  "https://res.cloudinary.com/di21pnpda/image/upload/w_500,h_500,c_fill,g_auto,f_auto,q_auto/v1787137015/WhatsApp_Image_2026-08-19_at_11.17.27_vicabt.jpg",
  "https://res.cloudinary.com/di21pnpda/image/upload/w_500,h_500,c_fill,g_auto,f_auto,q_auto/v1787137017/WhatsApp_Image_2026-08-19_at_11.17.28_rf9m4h.jpg",
  "https://res.cloudinary.com/di21pnpda/image/upload/w_500,h_500,c_fill,g_auto,f_auto,q_auto/v1787137016/WhatsApp_Image_2026-08-19_at_11.17.29_yb4see.jpg",
];

const VALEURS = [
  { title: "Identité", text: "Connaître nos racines pour mieux comprendre et affirmer qui nous sommes." },
  { title: "Transmission", text: "Faire circuler les savoirs, les langues, les récits, les gestes et les traditions entre les générations." },
  { title: "Excellence", text: "Donner aux talents culturels un cadre professionnel leur permettant de révéler leur potentiel et de rayonner." },
  { title: "Fraternité", text: "Réunir les communautés autour d'une mémoire, de valeurs et d'un avenir communs." },
];

const IMPACT_HIGHLIGHTS = [
  "Préserver et faire connaître les cultures endogènes béninoises",
  "Favoriser la transmission des savoirs et des traditions entre générations",
  "Donner une place centrale à la jeunesse dans la sauvegarde du patrimoine",
  "Offrir une visibilité aux talents culturels, artistiques et créatifs",
  "Créer des espaces de rencontre entre différentes communautés africaines",
  "Promouvoir l'excellence et le professionnalisme dans les initiatives culturelles",
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://hwendo-culture.site/#organization",
      "name": "Festival Hwendo-Culture",
      "description": "Festival dédié à la valorisation, la sauvegarde et la transmission des cultures endogènes béninoises",
      "url": "https://hwendo-culture.site",
    },
    {
      "@type": "Event",
      "@id": "https://hwendo-culture.site/#event",
      "name": "Festival Hwendo-Culture 2026",
      "description": description,
      "eventStatus": "EventScheduled",
      "eventAttendanceMode": "OnlineEventAttendanceMode",
      "location": {
        "@type": "VirtualLocation",
        "url": "https://hwendo-culture.site",
      },
      "url": "https://hwendo-culture.site",
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  ogTitle={title}
  ogDescription={description}
  ogType="website"
  structuredData={structuredData}
>
  <main class="min-h-screen bg-white">
    <!-- Hero -->
    <!-- z-0 (et pas juste "relative") est nécessaire : position:relative SANS
         z-index explicite reste z-index:auto, qui NE crée PAS de contexte
         d'empilement isolé. Sans ça, les calques -z-20/-z-10 ci-dessous
         "s'échappent" de la section et sont peints derrière le fond blanc de
         la page entière au lieu de rester DANS la section (fond invisible
         constaté en test). -->
    <section class="relative z-0 overflow-hidden py-12 text-white sm:py-20 lg:py-28">
      <!-- Fond "drapeau qui flotte" : un dégradé de base TOUJOURS visible
           (garantit qu'il n'y a jamais de fond blanc, même sans support
           d'animation) + 3 bandes de lumière/ombre diagonales qui balaient le
           fond à des vitesses différentes, ce qui simule le reflet changeant
           d'un tissu qui ondule au vent. Le contenu (texte, boutons) est dans
           un calque au-dessus, jamais affecté. -->
      <div class="hero-flag-base absolute inset-0 -z-20"></div>
      <div class="hero-flag-wave absolute inset-0 -z-20 overflow-hidden">
        <span class="wave-band wave-band-1"></span>
        <span class="wave-band wave-band-2"></span>
        <span class="wave-band wave-band-3"></span>
      </div>
      <div class="pointer-events-none absolute inset-0 overflow-hidden -z-10">
        <div class="absolute -top-40 -right-40 h-80 w-80 rounded-full bg-secondary-400/10 blur-3xl"></div>
        <div class="absolute -bottom-40 -left-40 h-80 w-80 rounded-full bg-white/5 blur-3xl"></div>
      </div>
      <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm font-semibold backdrop-blur-sm animate-fade-up">
          <span class="relative inline-flex h-2 w-2 rounded-full bg-secondary-400"></span>
          Édition 2026
        </span>
        <h1 class="mt-5 font-heading text-4xl font-black leading-tight text-balance sm:mt-6 sm:text-6xl lg:text-7xl animate-fade-up" style="animation-delay: 100ms;">
          Festival Hwendo<span class="text-secondary-300">-Culture</span>
        </h1>
        <p class="mx-auto mt-3 max-w-2xl font-heading text-lg italic text-secondary-200 sm:mt-4 sm:text-2xl animate-fade-up" style="animation-delay: 120ms;">
          « Nos racines sont notre avenir. »
        </p>
        <p class="mx-auto mt-4 max-w-2xl text-base text-white/90 sm:mt-6 sm:text-xl animate-fade-up" style="animation-delay: 150ms;">
          Un festival dédié à la valorisation, à la sauvegarde et à la transmission des cultures endogènes béninoises — à travers la mode, les arts, le sport et la parole.
        </p>
        <div class="mt-8 flex flex-col items-stretch gap-3 sm:mt-10 sm:flex-row sm:items-center sm:justify-center animate-fade-up" style="animation-delay: 200ms;">
          <a href="#categories" class="inline-flex items-center justify-center gap-2 rounded-lg bg-white px-6 py-3.5 font-bold text-primary-700 shadow-xl transition-all duration-200 hover:shadow-2xl active:scale-95 sm:px-8 sm:py-4">
            Découvrir les 3 catégories <span>↓</span>
          </a>
          <a href="/a-propos" class="inline-flex items-center justify-center gap-2 rounded-lg border border-white/30 bg-white/5 px-6 py-3.5 font-bold text-white backdrop-blur-sm transition-all duration-200 hover:bg-white/10 sm:px-8 sm:py-4">
            Découvrir le festival
          </a>
        </div>

        <div class="mx-auto mt-10 grid max-w-lg grid-cols-3 gap-3 sm:mt-14 sm:gap-6 animate-fade-up" style="animation-delay: 250ms;">
          {STATS.map((stat) => (
            <div>
              <p class="text-2xl font-black text-secondary-300 sm:text-3xl md:text-4xl">{stat.value}</p>
              <p class="mt-1 text-[11px] leading-tight text-white/70 sm:text-xs md:text-sm">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- À Propos (teaser) -->
    <section class="px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <div class="mb-10 text-center">
          <p class="text-sm font-semibold uppercase tracking-widest text-primary-600">Notre Identité</p>
          <h2 class="mt-2 font-heading text-3xl font-black text-slate-900 sm:text-4xl">À Propos du Festival</h2>
        </div>
        <p class="text-lg leading-relaxed text-slate-700">
          Hwendo-Culture est un festival dédié à la valorisation, à la sauvegarde et à la transmission des cultures endogènes béninoises. Pensé comme un espace de rencontre entre patrimoine, créativité et jeunesse, le festival transforme notre héritage culturel en une expérience vivante, accessible et tournée vers les générations futures.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-slate-700">
          À travers la mode, les arts, le sport, la parole et différentes initiatives culturelles, Hwendo-Culture crée un pont entre les traditions du Dahomey et les aspirations de la jeunesse africaine.
        </p>

        <div class="mt-10 grid gap-6 sm:grid-cols-2">
          <div class="rounded-2xl border border-primary-100 bg-primary-50/60 p-6">
            <h3 class="font-heading text-lg font-bold text-primary-700">Notre Mission</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-700">
              Promouvoir, préserver et assurer la transmission des cultures endogènes béninoises aux générations futures, en créant des espaces d'expression, de découverte, de partage et d'excellence.
            </p>
          </div>
          <div class="rounded-2xl border border-secondary-200 bg-secondary-50/60 p-6">
            <h3 class="font-heading text-lg font-bold text-secondary-800">Notre Vision</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-700">
              Faire de Hwendo-Culture une référence culturelle au Bénin et en Afrique, un mouvement où patrimoine, jeunesse et créativité se rencontrent pour construire une culture vivante.
            </p>
          </div>
        </div>

        <div class="mt-8 text-center">
          <a href="/a-propos" class="inline-flex items-center gap-2 font-semibold text-primary-600 hover:text-primary-700">
            En savoir plus sur le festival <span>→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Nos Grands Rendez-vous -->
    <section class="relative z-0 overflow-hidden bg-gradient-to-br from-primary-800 to-primary-950 px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <div class="mb-12 text-center">
          <p class="text-sm font-semibold uppercase tracking-widest text-secondary-300">Trois temps forts</p>
          <h2 class="mt-2 font-heading text-3xl font-black text-white sm:text-4xl">Nos Grands Rendez-vous</h2>
        </div>

        <div class="space-y-6">
          {RENDEZVOUS.map((rdv) => (
            <div class="rounded-3xl bg-white p-6 shadow-lg sm:p-8">
              <div class="flex items-center gap-3">
                <span class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-2xl bg-gradient-primary text-2xl text-white">
                  {rdv.icon}
                </span>
                <h3 class="font-heading text-xl font-bold text-slate-900">{rdv.title}</h3>
              </div>
              <p class="mt-4 leading-relaxed text-slate-700">{rdv.text}</p>
              {rdv.sub && (
                <ul class="mt-4 space-y-3">
                  {rdv.sub.map((s) => (
                    <li class="flex items-start gap-2 text-slate-700">
                      <span class="mt-1 flex-shrink-0 text-primary-600">●</span>
                      <span><strong class="text-slate-900">{s.label}</strong> — {s.text}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Galerie — teaser, fond sombre pour faire ressortir les photos -->
    <section class="relative z-0 overflow-hidden bg-slate-950 px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="mb-10 text-center">
          <p class="text-sm font-semibold uppercase tracking-widest text-secondary-400">En images</p>
          <h2 class="mt-2 font-heading text-3xl font-black text-white sm:text-4xl">Le Festival Hwendo-Culture</h2>
        </div>

        <div class="grid grid-cols-3 gap-3 sm:gap-4">
          {GALLERY_PREVIEW.map((url) => (
            <div class="aspect-square overflow-hidden rounded-xl">
              <img
                src={url}
                alt="Festival Hwendo-Culture"
                class="h-full w-full object-cover"
                loading="eager"
              />
            </div>
          ))}
        </div>

        <div class="mt-10 text-center">
          <a
            href="/galerie"
            class="inline-flex items-center gap-2 rounded-lg bg-gradient-to-r from-secondary-600 to-secondary-500 px-8 py-4 font-bold text-white shadow-lg transition-all duration-300 hover:scale-[1.03] hover:shadow-2xl"
          >
            <span>📸</span>
            <span>Voir toute la galerie</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Catégories -->
    <section id="categories" class="px-4 py-16 sm:px-6 sm:pb-20 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="mb-14 text-center">
          <p class="text-sm font-semibold uppercase tracking-widest text-primary-600">3 concours, 1 festival</p>
          <h2 class="mt-2 font-heading text-3xl font-black text-slate-900 sm:text-4xl">Choisissez votre catégorie</h2>
          <p class="mx-auto mt-4 max-w-2xl text-slate-600">
            Chaque catégorie a ses propres candidats et son propre vote en ligne, sécurisé via FedaPay.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
          {Object.values(CATEGORIES).map((cat) => {
            const visual = CATEGORY_VISUALS[cat.key];
            return (
              <a
                href={`/${cat.key}`}
                class="group flex flex-col overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-md transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl"
              >
                <div class={`flex h-40 items-center justify-center bg-gradient-to-br ${visual.gradient}`}>
                  {cat.logo ? (
                    <img src={cat.logo} alt={cat.label} class="h-24 w-24 rounded-full object-cover shadow-lg ring-4 ring-white/30" />
                  ) : (
                    <span class="text-6xl">{visual.emoji}</span>
                  )}
                </div>
                <div class="flex flex-1 flex-col gap-3 p-6 sm:p-8">
                  <h3 class="font-heading text-xl font-bold text-slate-900">{cat.label}</h3>
                  {cat.subtitle && (
                    <p class="text-sm font-semibold uppercase tracking-wide text-primary-600">{cat.subtitle}</p>
                  )}
                  <p class="mt-auto flex items-center gap-2 pt-4 font-semibold text-primary-600 transition-transform duration-300 group-hover:translate-x-1">
                    Découvrir et voter <span>→</span>
                  </p>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Nos Valeurs -->
    <section class="relative z-0 overflow-hidden bg-gradient-to-br from-primary-800 to-primary-950 px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <div class="mb-12 text-center">
          <p class="text-sm font-semibold uppercase tracking-widest text-secondary-300">Ce qui nous guide</p>
          <h2 class="mt-2 font-heading text-3xl font-black text-white sm:text-4xl">Nos Valeurs</h2>
        </div>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {VALEURS.map((v) => (
            <div class="rounded-2xl bg-white p-6 text-center shadow-lg">
              <h3 class="font-heading text-lg font-bold text-primary-700">{v.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{v.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Notre Impact -->
    <section class="px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl rounded-3xl bg-gradient-to-br from-primary-50 to-secondary-50 border border-primary-100 p-8 sm:p-12">
        <p class="text-sm font-semibold uppercase tracking-widest text-primary-600">Notre Impact</p>
        <h2 class="mt-2 font-heading text-2xl font-black text-slate-900 sm:text-3xl">
          À travers ses initiatives, Hwendo-Culture contribue à :
        </h2>
        <ul class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {IMPACT_HIGHLIGHTS.map((item) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-primary-600 text-xs font-bold text-white">✓</span>
              <span class="text-slate-700">{item}</span>
            </li>
          ))}
        </ul>
        <div class="mt-8">
          <a href="/a-propos" class="inline-flex items-center gap-2 font-semibold text-primary-600 hover:text-primary-700">
            Voir tout notre impact <span>→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Devenez Partenaire — bandeau plein largeur (pas juste une carte
         flottante) pour clore le rythme rouge/blanc de la page. -->
    <section class="relative z-0 overflow-hidden bg-gradient-to-br from-primary-800 to-primary-950 px-4 py-16 text-white sm:px-6 sm:py-20 lg:px-8">
      <div class="pointer-events-none absolute inset-0 overflow-hidden -z-10">
        <div class="absolute -top-24 -right-24 h-72 w-72 rounded-full bg-secondary-400/10 blur-3xl"></div>
      </div>
      <div class="relative mx-auto max-w-3xl text-center">
        <h2 class="font-heading text-2xl font-black sm:text-3xl">Devenez Partenaire ou Sponsor</h2>
        <p class="mt-2 font-semibold text-secondary-300">Construisons ensemble l'avenir de notre patrimoine</p>
        <p class="mx-auto mt-4 max-w-2xl text-white/90 leading-relaxed">
          Hwendo-Culture ouvre ses portes aux entreprises, institutions, organisations, marques et acteurs qui souhaitent associer leur image à une initiative culturelle porteuse de sens.
        </p>
        <a href="/sponsoring" class="mt-6 inline-block rounded-lg bg-white px-8 py-3 font-semibold text-primary-800 transition-colors duration-200 hover:bg-secondary-50">
          En savoir plus sur les partenariats
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* Calque 1 : le dégradé (+ fine trame diagonale façon tissage), TOUJOURS
     rendu tel quel — rien ici ne dépend d'une animation ou d'un filtre, donc
     ce fond ne peut jamais disparaître. */
  .hero-flag-base {
    background:
      repeating-linear-gradient(
        115deg,
        rgba(255, 255, 255, 0.05) 0px,
        rgba(255, 255, 255, 0.05) 2px,
        transparent 2px,
        transparent 26px
      ),
      linear-gradient(135deg, #7a1820 0%, #3d0a0f 100%);
  }

  /* Calque 2 : 3 bandes de lumière/ombre diagonales, chacune plus large que
     le conteneur, qui glissent et s'inclinent en boucle à des vitesses et
     déphasages différents — l'effet composite lu à l'œil est celui d'un
     reflet qui se déplace sur un tissu qui ondule. */
  .hero-flag-wave {
    pointer-events: none;
  }

  .wave-band {
    position: absolute;
    top: -30%;
    left: -30%;
    width: 160%;
    height: 160%;
    display: block;
    animation: heroWaveSweep 9s ease-in-out infinite;
  }

  .wave-band-1 {
    background: linear-gradient(100deg, transparent 42%, rgba(255, 255, 255, 0.12) 50%, transparent 58%);
    animation-duration: 8s;
  }

  .wave-band-2 {
    background: linear-gradient(100deg, transparent 38%, rgba(0, 0, 0, 0.16) 48%, transparent 60%);
    animation-duration: 11s;
    animation-delay: -3.5s;
  }

  .wave-band-3 {
    background: linear-gradient(100deg, transparent 46%, rgba(255, 232, 113, 0.1) 54%, transparent 64%);
    animation-duration: 9.5s;
    animation-delay: -6s;
  }

  @keyframes heroWaveSweep {
    0%, 100% { transform: translateX(-12%) skewX(-8deg); }
    50% { transform: translateX(12%) skewX(8deg); }
  }

  /* Respecte la préférence système : pas d'ondulation continue pour les
     personnes sensibles au mouvement — le dégradé de base reste affiché. */
  @media (prefers-reduced-motion: reduce) {
    .wave-band {
      animation: none;
      display: none;
    }
  }
</style>
